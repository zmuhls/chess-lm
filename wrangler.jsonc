{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "chess-lm",
  "account_id": "452c33847cf5cb1e46f391fca32fd1b5",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-19",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "services": [
    {
      "binding": "GATEWAY",
      "service": "cail-model-api"
    }
  ],
  "ratelimits": [
    {
      "name": "REQUEST_LIMIT",
      "namespace_id": "74106",
      "simple": {
        "limit": 12,
        "period": 60
      }
    },
    {
      "name": "GLOBAL_LIMIT",
      "namespace_id": "74107",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "vars": {
    "PUBLIC_ORIGIN": "https://chess-lm.ailab-452.workers.dev",
    "COACH_MODEL": "@cf/google/gemma-4-26b-a4b-it",
    "RELEASE": "dev"
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "dev": {
    "ip": "127.0.0.1",
    "port": 8797
  }
}
